{
  "expo": {
    "name": "LagosFare",
    "slug": "lagosfare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lagosfare",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lagosfare.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "LagosFare uses your location to fill in the area you are travelling from."
      }
    },
    "android": {
      "package": "com.lagosfare.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B3D2C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "LagosFare uses your location to fill in the area you are travelling from."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B3D2C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bdc03c50-afd0-4686-a562-6490cd96818e"
      }
    }
  }
}
